{
  "name": "pi-agent-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local pi extensions. These devDependencies exist ONLY so the editor (VS Code / tsserver) can resolve imports. Pi loads the extensions via jiti at runtime using its own bundled copies of these packages, so nothing here changes runtime behaviour.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:installed": "node tests/installed-extensions.smoke.mjs",
    "typecheck": "tsc --noEmit",
    "skill:lint": "node benchmarks/skill-governor/lint.mjs",
    "skill:bench": "node benchmarks/skill-governor/run.mjs --runs 3",
    "skill:report": "node benchmarks/skill-governor/report.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@types/node": "^22",
    "typebox": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
